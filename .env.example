# Provedor de IA: "gemini" (usa a API do Google) ou "mock" (sem IA, para testes offline)
AI_PROVIDER=gemini

# Crie sua chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui
# Confira os modelos disponíveis em https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Opcional: modelos reserva, usados se o principal estiver sobrecarregado (separados por vírgula)
GEMINI_MODELOS_RESERVA=

# Máximo de análises com IA por dia (protege a cota da chave). 0 = sem limite
AI_LIMITE_DIARIO=0

# Endereço do webhook do n8n que a central usa no simulador
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sindico

# Caminho do banco SQLite
DATABASE_PATH=/data/sindico.db

# Fuso horário usado para o resumo diário
TZ=America/Sao_Paulo
